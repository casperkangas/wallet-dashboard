<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.controllers.AnalyticsController">
    <VBox spacing="20" style="-fx-padding: 20;">
        <Label text="Analytics" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        
        <!-- KPI Cards -->
        <HBox spacing="20">
            <VBox styleClass="widget-card" HBox.hgrow="ALWAYS">
                <Label text="Savings Rate" styleClass="widget-title"/>
                <Label fx:id="lblSavingsRate" text="0.0%" styleClass="widget-value"/>
                <Label text="Current month" style="-fx-text-fill: #9e9e9e; -fx-font-size: 12px;"/>
            </VBox>
            <VBox styleClass="widget-card" HBox.hgrow="ALWAYS">
                <Label text="Emergency Fund" styleClass="widget-title"/>
                <Label fx:id="lblEmergencyFund" text="0.0 Months" styleClass="widget-value"/>
                <Label text="Cash / Avg Expenses" style="-fx-text-fill: #9e9e9e; -fx-font-size: 12px;"/>
            </VBox>
            <VBox styleClass="widget-card" HBox.hgrow="ALWAYS">
                <Label text="FI Ratio" styleClass="widget-title"/>
                <Label fx:id="lblFiRatio" text="0.0%" styleClass="widget-value"/>
                <Label text="Investments / Annual Exp" style="-fx-text-fill: #9e9e9e; -fx-font-size: 12px;"/>
            </VBox>
            <VBox styleClass="widget-card" HBox.hgrow="ALWAYS">
                <Label text="Expense Volatility" styleClass="widget-title"/>
                <Label fx:id="lblVolatility" text="$0.00" styleClass="widget-value"/>
                <Label text="Std Dev (Last 6 Months)" style="-fx-text-fill: #9e9e9e; -fx-font-size: 12px;"/>
            </VBox>
        </HBox>
        
        <!-- Charts Row 1 -->
        <HBox spacing="20" prefHeight="400">
            <VBox styleClass="widget-card" HBox.hgrow="ALWAYS" prefWidth="500">
                <Label text="Net Worth Over Time" styleClass="widget-title"/>
                <LineChart fx:id="netWorthChart" legendVisible="false" VBox.vgrow="ALWAYS">
                    <xAxis>
                        <CategoryAxis label="Date" side="BOTTOM" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Amount" side="LEFT" />
                    </yAxis>
                </LineChart>
            </VBox>
            
            <VBox styleClass="widget-card" HBox.hgrow="ALWAYS" prefWidth="500">
                <Label text="Income vs Expenses (Last 3 Months)" styleClass="widget-title"/>
                <BarChart fx:id="incomeExpenseChart" VBox.vgrow="ALWAYS">
                    <xAxis>
                        <CategoryAxis label="Month" side="BOTTOM" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Amount" side="LEFT" />
                    </yAxis>
                </BarChart>
            </VBox>
        </HBox>
        
        <!-- Charts Row 2 -->
        <HBox spacing="20" prefHeight="400">
            <VBox styleClass="widget-card" HBox.hgrow="ALWAYS">
                <Label text="Spending by Category (Current Month)" styleClass="widget-title"/>
                <PieChart fx:id="categoryPieChart" VBox.vgrow="ALWAYS"/>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
