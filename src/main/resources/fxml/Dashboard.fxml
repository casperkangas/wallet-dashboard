<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.controllers.DashboardController" spacing="20">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Overview" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Refresh Data" onAction="#loadData" style="-fx-padding: 8 15;" />
    </HBox>
    
    <GridPane hgap="20" vgap="20">
        <!-- Static Top Row -->
        <VBox styleClass="widget-card" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS" alignment="CENTER_LEFT" minWidth="200">
            <Label text="Total Balance (Net Worth)" styleClass="widget-title"/>
            <Label fx:id="lblTotalBalance" text="-" styleClass="widget-value, widget-positive"/>
        </VBox>
        
        <VBox styleClass="widget-card" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS" alignment="CENTER_LEFT" minWidth="200">
            <Label text="Savings Rate (This Month)" styleClass="widget-title"/>
            <Label fx:id="lblSavingsRate" text="0%" styleClass="widget-value"/>
        </VBox>

        <VBox styleClass="widget-card" GridPane.columnIndex="2" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS" alignment="CENTER_LEFT" minWidth="200">
            <Label text="Budget Remaining" styleClass="widget-title"/>
            <Label fx:id="lblBudgetRemaining" text="WIP" styleClass="widget-value"/>
        </VBox>
    </GridPane>
    
    <Label text="Accounts by Type" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <FlowPane fx:id="dynamicWidgetsContainer" hgap="20" vgap="20" />
    
</VBox>
