<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.controllers.DashboardController" spacing="20">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label text="Overview" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    
    <HBox spacing="20">
        <!-- Total Balance Widget -->
        <VBox styleClass="widget-card" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <Label text="Total Balance" styleClass="widget-title"/>
            <Label fx:id="lblTotalBalance" text="\$0.00" styleClass="widget-value, widget-positive"/>
        </VBox>
        
        <!-- Active Accounts Widget -->
        <VBox styleClass="widget-card" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <Label text="Active Accounts" styleClass="widget-title"/>
            <Label fx:id="lblAccountCount" text="0" styleClass="widget-value"/>
        </VBox>
        
        <!-- Placeholder -->
        <VBox styleClass="widget-card" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <Label text="Monthly Spending" styleClass="widget-title"/>
            <Label text="-" styleClass="widget-value"/>
        </VBox>
    </HBox>
    
    <Button text="Refresh Data" onAction="#loadData" />
    
</VBox>
