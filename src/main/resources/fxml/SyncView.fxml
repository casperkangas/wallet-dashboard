<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.controllers.SyncController" spacing="20">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label text="Synchronization" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    
    <VBox styleClass="sync-panel" spacing="15">
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Button fx:id="btnSyncNow" text="Sync Now" onAction="#performSync" style="-fx-font-size: 14px; -fx-padding: 8 16;"/>
            <ProgressIndicator fx:id="progressIndicator" prefWidth="20" prefHeight="20"/>
            <Label fx:id="lblStatus" text="Ready" style="-fx-text-fill: #555555;"/>
        </HBox>
        
        <HBox spacing="10">
            <Label text="Last Synced: " style="-fx-font-weight: bold;"/>
            <Label fx:id="lblLastSynced" text="Never"/>
        </HBox>
    </VBox>
</VBox>
